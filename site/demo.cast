[0.003, "o", "\u001b[30m\u001b[46m/root/backup.yaml   [----]  0 L:[  1+12  13/ 13] *(324 / 324b) <EOF>                [*][X]\u001b[2;1H\u001b[93m\u001b[44mrestic:\u001b[37m\u001b[K\r\n  \u001b[93mrepo: \u001b[37m/home/backup-user/backups/restic-repo\u001b[K\r\n  \u001b[93mpassword_file: \u001b[37m/root/.restic-env \u001b[33m# created automatically by --init-server, if the file d\u001b[5;1H\u001b[37m\u001b[K\n\u001b[93mbackup_user: \u001b[37mbackup-user\u001b[K\r\n\u001b[K\n\u001b[93mdatabases: \u001b[33m# supported type: mysql, postgres\u001b[37m\u001b[K\r\n\u001b[96m  - \u001b[93mtype: \u001b[37mmysql\u001b[K\r\n    \u001b[93mnames:\u001b[37m\u001b[K\r\n\u001b[96m      - \u001b[37mexample_db\u001b[K\r\n\u001b[K\n\u001b[93mschedule: \u001b[32m\"02:00\"\u001b[37m \u001b[33m# UTC, server backup time\u001b[37m\u001b[K\r\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[97m\u001b[40m 1\u001b[30m\u001b[46mHelp   \u001b[97m\u001b[40m 2\u001b[30m\u001b[46mSave   \u001b[97m\u001b[40m 3\u001b[30m\u001b[46mMark   \u001b[97m\u001b[40m 4\u001b[30m\u001b[46mReplac \u001b[97m\u001b[40m 5\u001b[30m\u001b[46mCopy   \u001b[97m\u001b[40m 6\u001b[30m\u001b[46mMove   \u001b[97m\u001b[40m 7\u001b[30m\u001b[46mSearch \u001b[97m\u001b[40m 8\u001b[30m\u001b[46mDelete \u001b[97m\u001b[40m 9\u001b[30m\u001b[46mPullDn \u001b[97m\u001b[40m10\u001b[30m\u001b[46mQuit\u001b[K\u001b[14;1H"]
