[0.885, "o", "\r\n\u001b[?2004l\r"]
[0.001, "o", "config written to backup.yaml (mode=server)"]
[0.002, "o", "\r\n\r\nNext:\r\n  1. Open backup.yaml and fill in the real database names under databases: (right\r\n     now there's just the example_db placeholder).\r\n  2. If you want the SAME restic password as on another server (one\r\n     shared password across every repository — easier to manage), run\r\n     --init-server with:\r\n       sudo backupctl --init-server -config=backup.yaml -restic-password=\"<password-from-that-server>\"\r\n     If the password doesn't matter, just:\r\n       sudo backupctl --init-server -config=backup.yaml\r\n     Then a random password will be generated and shown in the console once.\r\n\u001b]0;root@postgres: /root\u0007\u001b[?2004h\u001b[01;33mroot@postgres \u001b[01;34m~\u001b[00m# \u001b[K"]
